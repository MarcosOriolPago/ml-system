# Copy to .env and change every secret before first start.

# DNS name the team uses to reach this server (a hostname, not an IP and not "localhost")
STACK_HOST=ml-server.example.lan

POSTGRES_PASSWORD=change-me-postgres

# S3 key used only by the MLflow server (team members never need it)
MLFLOW_S3_ACCESS_KEY=mlflow
MLFLOW_S3_SECRET_KEY=change-me-mlflow-s3

# S3 key shared with the team for `dvc push/pull` (only sees bucket dvc-storage)
DVC_S3_ACCESS_KEY=dvc
DVC_S3_SECRET_KEY=change-me-dvc-s3

# Host names/IPs people use to reach MLflow (localhost + private IPs always work)
MLFLOW_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,10.*,192.168.*,172.*

# Host ports
MLFLOW_PORT=5000
REGISTRY_PORT=5001
S3_PORT=8333
